# =============================================================================
# yt-summary configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env && chmod 600 .env
# .env is NOT committed to git (see .gitignore). Keep secrets out of the repo.
#
# Every option below can also be passed as an environment variable.
# Precedence: CLI flags > environment variables > .env > hard defaults.
# Run 'yt-summary --help-all' to see this same list with the values that are
# effective for the current run.
# =============================================================================

# --- LLM backend selection ---
# Choose the backend: ollama, omniroute (hard default) or litellm.
# Only the options for the selected backend are taken into account.
LLM_BACKEND=ollama

# --- LLM backend: Ollama (default) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_NUM_CTX=24000
MAX_TOKENS=30000
TEMPERATURE=0.1
MAX_RETRIES=5

# --- LLM backend: LiteLLM proxy (optional) ---
# Set LLM_BACKEND=litellm to use these.
LITELLM_PROXY_URL=
LITELLM_MODEL=
LITELLM_API_KEY=

# --- LLM backend: Omniroute proxy (optional) ---
# Set LLM_BACKEND=omniroute to use these.
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=

# --- Unified LLM overrides (optional) ---
# Applied to whichever backend LLM_BACKEND selects; they override the
# backend-specific variables above (same effect as --url/-m/--api-key).
LLM_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Deprecated backend switches (optional) ---
# Kept for backward compatibility only: true selects the matching backend
# unless LLM_BACKEND says otherwise. Prefer LLM_BACKEND.
USE_LITELLM=false
USE_OMNIROUTE=false

# --- LLM backend: Fallback cascade (optional) ---
# Set LLM_BACKEND=fallback to use these. The fallback backend tries:
#   1. Omniroute (with the configured OMNIROUTE_* options above)
#   2. Ollama Cloud (OpenAI-compatible API, multiple keys in priority order)
#   3. Ollama Local (localhost:11434, last resort)
# If all three fail, the request is aborted.

# Comma-separated list of Ollama Cloud API keys (1-3), tried in order.
# If one key is not usable or quota exhausted, the next is tried.
OLLAMA_CLOUD_API_KEYS=

# Ollama Cloud API base URL (OpenAI-compatible interface)
OLLAMA_CLOUD_URL=https://api.ollama.cloud

# Model name to use with Ollama Cloud
OLLAMA_CLOUD_MODEL=

# Model name for local Ollama (used as last resort)
OLLAMA_LOCAL_MODEL=gemma2:2b

# --- Summarization ---
SUMMARY_LENGTH=medium
# Output language. When set, it is respected and audio-language detection is
# skipped. When unset, per-video detection runs:
# Romanian audio -> Romanian, otherwise English.
TARGET_LANGUAGE=en
CHUNK_WORDS=900
# Ask the LLM for the recommended chunk size before summarizing.
# false = always use CHUNK_WORDS.
AUTO_CHUNK=true
# Where summaries are cached (per video ID).
CACHE_DIR=/tmp/yt-summary-cache
# Maximum videos per playlist; 0 = no limit.
MAX_PLAYLIST_VIDEOS=0
# Skip playlist videos older than N days; 0 = no limit.
MAX_PLAYLIST_VIDEO_AGE_DAYS=0

# --- Prompt templates (optional) ---
# Override the default prompts. Each PROMPT_USER_* template supports these
# placeholders, replaced at use time:
#   {{LANG}}, {{CHUNK_TEXT}}, {{CHUNK_CONTEXT}}, {{MIN_SUMMARY_WORDS}},
#   {{LENGTH_GUIDANCE}}, {{CHUNK_SUMMARIES}}, {{MIN_BULLETS}},
#   {{MAX_BULLETS}}, {{FINAL_SUMMARY}}, {{INPUT_WORDS}},
#   {{DEFAULT_CHUNK_WORDS}}
# Single-line values (system prompts):
PROMPT_SYSTEM_CHUNK=You are an expert summarizer specializing in video transcripts. Produce clear, accurate summaries that capture the essential information. Output plain text only, no markdown, no quotes, no prefixes.
PROMPT_SYSTEM_AGGREGATE=You are an expert editor who combines partial summaries into a unified, coherent document. Output plain text only, no markdown, no quotes, no prefixes.
PROMPT_SYSTEM_KEYPOINTS=You are an expert at distilling information into actionable key points. Output only bullet points, no intro, no summary, no closing remarks.
PROMPT_SYSTEM_CHUNKSIZE=I will ask you to perform summarization of video transcripts. If your context window will allow it I will submit the whole text for summarization, if not I will submit in chunks, for a map-reduce summarization. Given the transcript word count, and your context window reply with the recommended number of words you can process. Output ONLY a positive integer — no prose, no units, no explanation. Do not iterate too much, return your best guess.
# Multi-line values use a heredoc form (same syntax as the defaults below):
#   PROMPT_USER_CHUNK=<<'PROMPT_EOC'
#   Summarize this transcript chunk...
#   Language: {{LANG}}
#   Transcript:
#   {{CHUNK_TEXT}}
#   PROMPT_EOC
# Leave the PROMPT_*_USER variables unset to keep the built-in defaults.
# A complete custom set would look like:
#PROMPT_USER_CHUNK=<<'PROMPT_EOC'
#Summarize this transcript chunk in a single coherent paragraph.
#Language: {{LANG}}
#
#Transcript:
#{{CHUNK_TEXT}}
#PROMPT_EOC
#PROMPT_USER_AGGREGATE=<<'PROMPT_EOA'
#Combine these chunk summaries into one flowing narrative.
#Target length: {{MIN_SUMMARY_WORDS}} words minimum
#Length guidance: {{LENGTH_GUIDANCE}}
#Language: {{LANG}}
#
#Chunk summaries:
#{{CHUNK_SUMMARIES}}
#PROMPT_EOA
#PROMPT_USER_KEYPOINTS=<<'PROMPT_EOK'
#Extract {{MIN_BULLETS}}-{{MAX_BULLETS}} key points from this content.
#Format: One bullet per line, starting with "- "
#Language: {{LANG}}
#
#Summary:
#{{FINAL_SUMMARY}}
#
#Source material:
#{{CHUNK_SUMMARIES}}
#PROMPT_EOK
#PROMPT_USER_CHUNKSIZE=<<'PROMPT_EOCS'
#Transcript word count: {{INPUT_WORDS}}
#Language: {{LANG}}
#PROMPT_EOCS

# --- Telegram notifications (optional) ---
SEND_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org

# --- MQTT notifications (optional) ---
# When MQTT_BROKER and MQTT_TOPIC are set, session statistics are published
# as JSON after processing completes (requires mosquitto-clients).
MQTT_BROKER=
MQTT_TOPIC=
MQTT_USER=
MQTT_PASSWORD=

# --- Email (optional) ---
EMAIL_FROM=

# --- TTS / audio (optional) ---
TTS_ENGINE=piper
AUDIO_FORMAT=m4a
AUDIO_VOICE=
# Directory holding the piper .onnx voices.
VOICES_DIR=/data/configs/voices
# TTS binaries: name resolved on PATH, or a full path to the executable.
PIPER_BIN=piper
EDGE_TTS_BIN=edge-tts
# Default voices when no --voice is specified. Used as fallbacks when
# AUDIO_VOICE is empty. Set these to voices that actually exist in
# VOICES_DIR (see: ls $VOICES_DIR/*.onnx).
# Piper defaults are filenames in VOICES_DIR (without the .onnx extension).
DEFAULT_VOICE_PIPER_EN=en_US-ryan-high
DEFAULT_VOICE_PIPER_RO=ro_RO-sanda-high
# edge-tts defaults are voice names (see: edge-tts --list-voices).
DEFAULT_VOICE_TTS_EN=en-US-EmmaMultilingualNeural
DEFAULT_VOICE_TTS_RO=ro-RO-AlinaNeural

# --- Whisper transcription fallback (optional) ---
# When no subtitle (manual or auto-generated) can be obtained for a video,
# yt-summary downloads the audio track and transcribes it with
# whisper-ctranslate2 (requirements 2.3-2.5). This requires the
# whisper-ctranslate2 binary locally, or a remote host reachable over SSH.
# Set WHISPER_ENABLED=false (or pass --no-whisper) to disable the fallback.
WHISPER_ENABLED=true
# Optional yt-dlp cookies file used for subtitle downloads. YouTube throttles
# the caption endpoint with HTTP 429 for anonymous requests; cookies avoid
# that, so auto-generated subtitles are used instead of falling back to
# whisper. Point this at an existing yt-dlp cookies file (e.g. the one used
# by your yt-dlp config).
#YTDLP_COOKIES=/home/marp/.config/yt-dlp/cookies.txt
# Location of whisper-ctranslate2: localhost or a remote IP/hostname.
WHISPER_HOST=localhost
# whisper model: tiny, base, small, medium, large-v3 (default: medium).
WHISPER_MODEL=medium
# Binary name/path when WHISPER_HOST=localhost.
WHISPER_BIN=whisper-ctranslate2
# --- Remote access over SSH (only when WHISPER_HOST is remote) ---
# SSH username used to reach the remote whisper host.
WHISPER_SSH_USER=
# SSH auth mode: config | key | password
#   config   -> rely on ~/.ssh/config (host alias / user / key)
#   key      -> WHISPER_SSH_KEY is used
#   password -> WHISPER_SSH_PASSWORD is used (requires sshpass)
WHISPER_SSH_AUTH=config
# Path to the SSH private key when WHISPER_SSH_AUTH=key. The value must be a
# real path: '~' is not expanded here, so leave it unset to use the built-in
# default ($HOME/.ssh/id_rsa).
#WHISPER_SSH_KEY=/home/marp/.ssh/id_rsa
WHISPER_SSH_PASSWORD=
# Audio transfer method to the remote host: rsync | scp | shared
#   shared -> WHISPER_SHARED_DIR must be a path valid on BOTH machines
#             (e.g. an NFS mount); no transfer is performed.
WHISPER_TRANSFER=rsync
WHISPER_REMOTE_DIR=/tmp/yt-summary-whisper
WHISPER_SHARED_DIR=

# --- Paths ---
# Base directory for temporary files. Leave empty (or unset) to let yt-summary
# create a fresh mktemp directory per run; a directory set here is reused and
# is NOT deleted when the script exits.
#TMP_BASE=/temp/yt-summary
# File listing already-processed video IDs, used to skip them by default.
# Use --force to reprocess anyway.
EXTERNAL_TRACKING_FILE=/data/ltr/yt-dlp/files
