# =============================================================================
# yt-summary configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env && chmod 600 .env
# .env is NOT committed to git (see .gitignore). Keep secrets out of the repo.
# =============================================================================

# --- LLM backend selection ---
# Choose the backend: ollama (default), litellm, or omniroute.
# Only the options for the selected backend are taken into account.
LLM_BACKEND=ollama

# --- LLM backend: Ollama (default) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma2:2b
OLLAMA_NUM_CTX=24000
MAX_TOKENS=30000
TEMPERATURE=0.1
MAX_RETRIES=5

# --- LLM backend: LiteLLM proxy (optional) ---
# Set LLM_BACKEND=litellm to use these.
LITELLM_PROXY_URL=
LITELLM_MODEL=
LITELLM_API_KEY=

# --- LLM backend: Omniroute proxy (optional) ---
# Set LLM_BACKEND=omniroute to use these.
OMNIROUTE_URL=http://localhost:20128
OMNIROUTE_MODEL=
OMNIROUTE_API_KEY=

# --- Summarization ---
SUMMARY_LENGTH=medium
TARGET_LANGUAGE=en
CHUNK_WORDS=900
CACHE_DIR=
MAX_PLAYLIST_VIDEO_AGE_DAYS=0
MAX_PLAYLIST_VIDEOS=0

# --- Telegram notifications (optional) ---
SEND_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_URL=https://api.telegram.org

# --- Email (optional) ---
EMAIL_FROM=

# --- TTS / audio (optional) ---
TTS_ENGINE=piper
AUDIO_FORMAT=m4a
AUDIO_VOICE=
VOICES_DIR=

# --- Paths ---
TMP_BASE=
EXTERNAL_TRACKING_FILE=
